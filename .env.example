# Everything here is optional. With no variables set, the app runs fully on the bundled seed data
# and the deterministic matching engine.

# Public URL used for metadata (Open Graph). Optional.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optional AI summaries (server-side only; never exposed to the browser) ──
# When set, the results page offers an opt-in, consent-gated summary per recommendation.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5 when empty.
ANTHROPIC_MODEL=

# ── Optional Supabase catalog (see supabase/schema.sql and README) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Needed only for the admin area to list drafts and save records. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin area (/admin). If either is empty, /admin returns 404. ──
ADMIN_USER=
ADMIN_PASSWORD=
