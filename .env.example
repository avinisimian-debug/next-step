# Everything here is optional. With no variables set, the app runs fully on the bundled seed data
# and the deterministic matching engine.

# Public URL used for metadata (Open Graph). Optional.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optional AI (server-side only; never exposed to the browser) ──
# Enables the assistant and opt-in summaries on the results page.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5 when empty.
ANTHROPIC_MODEL=

# ── Optional Supabase: accounts, community, catalog (see README "Database setup") ──
# Read on the server at runtime only. The publishable key is not a secret, but RLS is what protects data.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Set to "supabase" to read the catalog from next_step.institutions instead of the bundled seed.
CATALOG_SOURCE=
# Only for the legacy /admin JSON editor's writes. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin area (/admin). If either is empty, /admin returns 404. ──
ADMIN_USER=
ADMIN_PASSWORD=
